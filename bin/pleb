#!/usr/bin/env bash
# pleb — manage the "Pleb" kilix kiosk desktop session.
#
#   pleb install            add "Pleb" as a choosable LightDM session (needs sudo)
#   pleb uninstall          remove it
#   pleb test [opts]        try it in a throwaway X server (see: pleb test --help)
#   pleb autologin on|off   boot straight into Pleb (kiosk) / back to greeter
#   pleb kiosk on|off       hard kiosk: respawn kilix if it exits / don't
#   pleb update [-y] [--no-restart|--restart]
#                           pull latest kilix, rebuild, optionally restart kiosk
#   pleb status             show install + engine state
#   pleb version            print the Plebian-OS release version
#   pleb doctor             check prerequisites
#   pleb screen-size ...    show/increase/decrease/reset Kilix terminal scale
#   pleb settings           configure shared Kilix chrome in a terminal UI
#   pleb session            exec the session now (for the current $DISPLAY)
#
# Non-destructive: your current desktop session is untouched; "Pleb" is another choice
# at the login screen. Uninstall removes the session integration while keeping
# downloaded checkouts and any packages installed as dependencies.
set -euo pipefail

# Resolve symlinks so `ln -s .../bin/pleb /usr/local/bin/pleb` still finds the
# checkout (pleb install links it onto PATH exactly that way).
_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
PLEB_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
# shellcheck source=/dev/null
. "$PLEB_ROOT/lib/common.sh"
. "$PLEB_ROOT/lib/install.sh"
. "$PLEB_ROOT/lib/autologin.sh"
. "$PLEB_ROOT/lib/test.sh"
. "$PLEB_ROOT/lib/kiosk.sh"
. "$PLEB_ROOT/lib/update.sh"

# print the leading comment block (line 2 until the first non-comment line)
usage() { awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "${BASH_SOURCE[0]}"; }

# The root window points at a check window that must point back at itself; a
# root property left behind by a dead WM fails that test. Ids are compared
# numerically because 0x400003 and 0x0400003 are the same window. This mirrors
# the detection in bin/pleb-session, which is intentionally self-contained and
# cannot source the checkout.
wm_check_window() {
    local root child
    command -v xprop >/dev/null 2>&1 || return 1
    root="$(xprop -root -notype _NET_SUPPORTING_WM_CHECK 2>/dev/null | awk '/# / {print $NF; exit}')"
    [ -n "$root" ] || return 1
    child="$(xprop -id "$root" -notype _NET_SUPPORTING_WM_CHECK 2>/dev/null | awk '/# / {print $NF; exit}')"
    [ -n "$child" ] || return 1
    [ "$(printf '%d' "$root" 2>/dev/null)" = "$(printf '%d' "$child" 2>/dev/null)" ] || return 1
    printf '%s\n' "$root"
}

# name the live WM advertises on that window ("Openbox", "Xfwm4", …)
wm_check_name() {
    local win name
    win="$(wm_check_window)" || return 1
    name="$(xprop -id "$win" -notype _NET_WM_NAME 2>/dev/null \
                | sed -n 's/^_NET_WM_NAME = "\(.*\)"$/\1/p')"
    [ -n "$name" ] || return 1
    printf '%s\n' "$name"
}

cmd_status() {
    log "Pleb kiosk desktop — status"
    local eng="$KILIX_DEFAULT"
    if [ -x "$eng" ] && "$eng" --which >/dev/null 2>&1; then
        info "engine   : $("$eng" --which 2>/dev/null | tail -1)  [$eng]"
    else
        info "engine   : NOT RUNNABLE at $eng  (run $KILIX_DIR/bootstrap.sh)"
    fi
    if [ -f "$XSESSION_DST" ]; then info "session  : installed ($XSESSION_DST)"
    else info "session  : not installed  (run: pleb install)"; fi
    if [ -x "$SESSION_BIN_DST" ] && ! cmp -s "$PLEB_BIN_SRC" "$SESSION_BIN_DST"; then
        info "launcher : $SESSION_BIN_DST  (STALE: differs from $PLEB_BIN_SRC — run: pleb install)"
    elif [ -x "$SESSION_BIN_DST" ]; then info "launcher : $SESSION_BIN_DST"
    else info "launcher : not installed"; fi
    local wm_mode wm_desc wm_native openbox_bin wm_name
    wm_mode="${PLEB_WM:-auto}"
    openbox_bin="$(command -v openbox 2>/dev/null || true)"
    case "$wm_mode" in
        auto)     wm_desc="auto (openbox when available, else no WM)"; wm_native=1
                  [ -n "$openbox_bin" ] || wm_native=0 ;;
        openbox)  wm_desc="openbox (required)"; wm_native=1 ;;
        none|off) wm_desc="$wm_mode (kilix sizes itself to the screen)"; wm_native=0 ;;
        *)        wm_desc="custom: $wm_mode"; wm_native=1 ;;
    esac
    info "wm       : $wm_desc"
    if [ -n "$openbox_bin" ]; then info "openbox  : $openbox_bin"
    else info "openbox  : not installed  (run: pleb install)"; fi
    if [ ! -f "$OPENBOX_CONFIG_DST" ]; then
        info "wm config: not installed  (run: pleb install)"
    elif cmp -s "$OPENBOX_CONFIG_SRC" "$OPENBOX_CONFIG_DST"; then
        info "wm config: $OPENBOX_CONFIG_DST  (matches checkout)"
    else
        info "wm config: $OPENBOX_CONFIG_DST  (STALE: differs from $OPENBOX_CONFIG_SRC)"
    fi
    if [ -z "${DISPLAY:-}" ]; then info "active wm: unknown (no DISPLAY here)"
    elif wm_name="$(wm_check_name)"; then info "active wm: $wm_name  (on $DISPLAY)"
    elif command -v xprop >/dev/null 2>&1 && xprop -root -notype _NET_SUPPORTING_WM_CHECK >/dev/null 2>&1; then
        info "active wm: none on $DISPLAY"
    else info "active wm: unknown ($DISPLAY unreadable)"; fi
    case "${KILIX_RUN_ALIASES:-}" in
        1|yes|true|on)  info "gui apps : kilix run, in a kilix tab  (KILIX_RUN_ALIASES=$KILIX_RUN_ALIASES)" ;;
        0|no|false|off) info "gui apps : native windows  (KILIX_RUN_ALIASES=$KILIX_RUN_ALIASES)" ;;
        *) if [ "$wm_native" = 1 ]; then info "gui apps : native windows (the session WM manages them)"
           else info "gui apps : kilix run, in a kilix tab (no WM to manage them)"; fi ;;
    esac
    if [ -x "$KILIX_SETTINGS_LINK" ]; then
        info "settings : $GPU_TERMINAL_SETTINGS_FILE  [$KILIX_SETTINGS_LINK]"
    else
        info "settings : $GPU_TERMINAL_SETTINGS_FILE  (command not linked)"
    fi
    if [ -L "$KILIX_LINK" ]; then info "kilix cmd: $KILIX_LINK -> $(readlink "$KILIX_LINK")"
    else info "kilix cmd: not linked (run: pleb install)"; fi
    if [ -x "$KILIX_TEMPS_BIN" ] && [ -f "$KILIX_TEMPS_LIBRARY" ]; then
        info "temps    : installed at $KILIX_TEMPS_BIN"
    else
        info "temps    : missing (run: pleb install)"
    fi
    if [ -x "$TMUX_TUI_BIN" ] && [ -x "$TMUX_CLI_BIN" ]; then
        info "tmux     : manager $TMUX_TUI_BIN; cli alias $TMUX_CLI_BIN"
    else
        info "tmux     : manager or tb alias missing (run: pleb install)"
    fi
    if desktop_enabled; then
        info "desktop  : enabled via ${KILIX_DESKTOP_PROVIDER:-auto}${KILIX_DESKTOP_NAME:+ ($KILIX_DESKTOP_NAME)}"
    else
        info "desktop  : plain kilix shell"
    fi
    if [ -d "$KILIX95_DIR/.git" ] && [ -f "$KILIX95_DIR/main.py" ]; then
        info "kilix 95 : installed at $KILIX95_DIR"
    else
        info "kilix 95 : optional desktop not installed"
    fi
    if git -C "$KILIX_CAP_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        if [ -x "$KILIX_CAP_DIR/bin/kilix-cap" ]; then
            info "kilix cap: installed and built at $KILIX_CAP_DIR"
        else
            info "kilix cap: source at $KILIX_CAP_DIR (builds on first launch)"
        fi
    else
        info "kilix cap: optional desktop downloads on first launch"
    fi
    local logs_dir logs_state logs_count
    logs_dir="${KILIX_TRANSCRIPT_DIR:-$KILIX_STATE_DIRECTORY/transcripts}"
    logs_state="$(
        python3 -c "
import sys
sys.path.insert(0, '$KILIX_DIR/config')
from kilix_sdk import settings
print('%s, %s, %s per pane' % (
    'on' if settings.transcript_enabled() else 'off',
    settings.transcript_graphics(),
    settings.load().get(settings.TRANSCRIPT_LIMIT_KEY,
                        settings.TRANSCRIPT_LIMIT_DEFAULT)))
" 2>/dev/null
    )" || logs_state=""
    if [ -n "$logs_state" ]; then
        # The directory is created on the first Kilix launch, so its absence is
        # normal rather than an error worth failing status over.
        logs_count=0
        if [ -d "$logs_dir" ]; then
            logs_count="$(
                find "$logs_dir" -maxdepth 1 -type f -name '*.log' 2>/dev/null \
                    | wc -l || true
            )"
        fi
        info "logs     : $logs_state; $logs_count recorded in $logs_dir"
    else
        info "logs     : unknown (shared settings unreadable)"
    fi
    if [ -f "$AUTOLOGIN_CONF" ]; then
        info "autologin: ON  -> $(grep -sE '^autologin-user=' "$AUTOLOGIN_CONF" | cut -d= -f2)"
    else
        info "autologin: off (greeter shown)"
    fi
    if kiosk_is_on; then info "kiosk    : HARD (respawn kilix on exit)"
    else info "kiosk    : soft (kilix exit ends the session)"; fi
    local dm; dm="$(basename "$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)" 2>/dev/null || echo '?')"
    info "greeter  : $(systemctl is-active display-manager 2>/dev/null || echo unknown) ($dm)"
}

cmd_doctor() {
    local ok=1
    log "checking prerequisites"
    if [ -x "$KILIX_DEFAULT" ] && "$KILIX_DEFAULT" --which >/dev/null 2>&1; then
        info "[ok]  kilix engine: $("$KILIX_DEFAULT" --which 2>/dev/null | tail -1)"
    else
        info "[!!]  kilix engine not runnable at $KILIX_DEFAULT — run: $KILIX_DIR/bootstrap.sh"; ok=0
    fi
    for t in Xorg startx xset xsetroot xprop; do
        if command -v "$t" >/dev/null 2>&1; then info "[ok]  $t"; else info "[!!]  missing: $t"; ok=0; fi
    done
    local wm_mode wm_name
    wm_mode="${PLEB_WM:-auto}"
    case "$wm_mode" in
        none|off)
            info "[--]  PLEB_WM=$wm_mode — the session runs without a window manager" ;;
        auto)
            if command -v openbox >/dev/null 2>&1; then info "[ok]  openbox: $(command -v openbox)"
            else info "[--]  openbox absent — the session falls back to the no-WM fixed geometry"; fi ;;
        openbox)
            if command -v openbox >/dev/null 2>&1; then info "[ok]  openbox: $(command -v openbox)"
            else info "[!!]  PLEB_WM=openbox but openbox is not installed — run: pleb install"; ok=0; fi ;;
        *)
            # PLEB_WM is a command vector here; an all-whitespace value parses to
            # an empty array, so check the length before indexing it.
            local -a wm_argv=()
            read -r -a wm_argv <<< "$wm_mode" || true
            if [ "${#wm_argv[@]}" -gt 0 ] && command -v "${wm_argv[0]}" >/dev/null 2>&1; then
                info "[ok]  window manager: $(command -v "${wm_argv[0]}")  (PLEB_WM='$wm_mode')"
            else
                info "[!!]  PLEB_WM='$wm_mode' is not runnable — install it or set PLEB_WM=none"; ok=0
            fi ;;
    esac
    if [ -f "$OPENBOX_CONFIG_DST" ]; then
        info "[ok]  openbox profile installed: $OPENBOX_CONFIG_DST"
        if cmp -s "$OPENBOX_CONFIG_SRC" "$OPENBOX_CONFIG_DST"; then
            info "[ok]  openbox profile matches $OPENBOX_CONFIG_SRC"
        else
            info "[!!]  openbox profile differs from $OPENBOX_CONFIG_SRC — run: pleb install"; ok=0
        fi
    else
        info "[!!]  openbox profile not installed at $OPENBOX_CONFIG_DST — run: pleb install"; ok=0
    fi
    if [ ! -x "$SESSION_BIN_DST" ]; then
        info "[--]  session launcher not installed at $SESSION_BIN_DST"
    elif cmp -s "$PLEB_BIN_SRC" "$SESSION_BIN_DST"; then
        info "[ok]  installed session launcher matches $PLEB_BIN_SRC"
    else
        info "[!!]  installed session launcher $SESSION_BIN_DST is stale (differs from $PLEB_BIN_SRC) — run: pleb install"; ok=0
    fi
    if [ -n "${DISPLAY:-}" ]; then
        if ! command -v xprop >/dev/null 2>&1; then
            info "[--]  no xprop — cannot read the EWMH state of $DISPLAY"
        elif ! xprop -root -notype _NET_SUPPORTING_WM_CHECK >/dev/null 2>&1; then
            info "[--]  DISPLAY=$DISPLAY is not reachable — skipped the live WM check"
        elif wm_name="$(wm_check_name)"; then
            info "[ok]  EWMH window manager on $DISPLAY: $wm_name"
        elif wm_check_window >/dev/null 2>&1; then
            info "[--]  $DISPLAY advertises a WM check window with no _NET_WM_NAME"
        else
            info "[--]  no valid EWMH window manager on $DISPLAY (pleb starts its own)"
        fi
    fi
    if [ -x "$KILIX_TEMPS_BIN" ] && [ -f "$KILIX_TEMPS_LIBRARY" ]; then
        info "[ok]  Kilix Temps graphical dashboard"
    else
        info "[!!]  Kilix Temps is not installed — run: pleb install"; ok=0
    fi
    if command -v Xephyr >/dev/null 2>&1; then info "[ok]  Xephyr (nested testing)"
    else info "[--]  Xephyr absent — 'pleb test' will use a spare VT instead"; fi
    if [ -d /usr/share/xsessions ]; then info "[ok]  /usr/share/xsessions exists"
    else info "[--]  /usr/share/xsessions missing (created on install)"; fi
    if systemctl is-active --quiet lightdm 2>/dev/null; then info "[ok]  lightdm is the active greeter"
    else info "[--]  lightdm not active — session choice UI may differ"; fi
    echo
    if [ "$ok" = 1 ]; then log "doctor: ready to install/test."; else warn "doctor: fix the [!!] items first."; fi
    [ "$ok" = 1 ]
}

cmd_screen_size() {
    [ -x "$KILIX_DEFAULT" ] || die "kilix not runnable at $KILIX_DEFAULT"
    "$KILIX_DEFAULT" screen-size "$@"
}

cmd_settings() {
    local settings="$KILIX_DIR/kilix-settings"
    [ -f "$settings" ] || die "kilix-settings not found at $settings"
    exec python3 "$settings" "$@"
}

main() {
    local cmd="${1:-help}"; shift || true
    case "$cmd" in
        install)    do_install ;;
        uninstall)  do_uninstall ;;
        test)       case "${1:-}" in
                        -h|--help) grep -E '^#   pleb test' "$PLEB_ROOT/lib/test.sh" | sed 's/^# //' ;;
                        *) run_test "$@" ;;
                    esac ;;
        autologin)  case "${1:-}" in
                        on)  shift; autologin_on "$@" ;;
                        off) autologin_off ;;
                        *)   die "usage: pleb autologin on [user] | off" ;;
                    esac ;;
        kiosk)      case "${1:-}" in
                        on)  kiosk_on ;;
                        off) kiosk_off ;;
                        *)   die "usage: pleb kiosk on | off" ;;
                    esac ;;
        update)     do_update "$@" ;;
        status)     cmd_status ;;
        doctor)     cmd_doctor ;;
        screen-size|font-size)
                    cmd_screen_size "$@" ;;
        settings)   cmd_settings "$@" ;;
        session)    exec "$PLEB_BIN_SRC" ;;
        version|--version|-V)
                    echo "pleb $(cat "$PLEB_ROOT/VERSION" 2>/dev/null || echo unknown)" ;;
        help|-h|--help) usage ;;
        *)          err "unknown command: $cmd"; usage; exit 1 ;;
    esac
}
main "$@"
