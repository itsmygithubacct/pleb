#!/usr/bin/env bash
# Run a reviewed release driver against an older installed Pleb checkout.
# The installed checkout remains the participating PLEB_ROOT throughout.
set -euo pipefail
fail() { printf 'pleb-release-hop: %s\n' "$*" >&2; exit 1; }
installed=""
driver_ref=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --installed-pleb) [ "$#" -ge 2 ] && [ -z "$installed" ] || fail "one --installed-pleb is required"; installed="$2"; shift 2 ;;
        --driver-ref) [ "$#" -ge 2 ] && [ -z "$driver_ref" ] || fail "one --driver-ref is required"; driver_ref="$2"; shift 2 ;;
        --) shift; break ;;
        --help) printf '%s\n' 'usage: pleb-release-hop --installed-pleb PATH --driver-ref SHA -- update --to VERSION --release-tag TAG [options]' 'Uses installed configuration and a separate exact reviewed driver; never replaces the old CLI before selection.'; exit 0 ;;
        *) fail "unknown bootstrap option: $1" ;;
    esac
done
[ "$EUID" -ne 0 ] || fail "run as the installed Pleb user, without sudo"
[[ "$driver_ref" =~ ^[0-9a-f]{40}$ ]] || fail "--driver-ref must be a full commit SHA"
[ -n "$installed" ] && [ -x "$installed" ] || fail "--installed-pleb must name an executable installed CLI"
[ "${1:-}" = update ] && [ "$#" -gt 1 ] || fail "an explicit update operation is required"
shift
case "$1" in --to|--to=*|--rollback|--show|--help|-h) ;; *) fail "bootstrap requires a named release operation" ;; esac
self="$(readlink -f -- "${BASH_SOURCE[0]}")"
driver_root="$(cd "$(dirname "$self")/.." && pwd -P)"
[ "$(git -C "$driver_root" rev-parse --verify HEAD)" = "$driver_ref" ] || fail "driver checkout is not the requested commit"
snapshot="$(mktemp -d "${TMPDIR:-/tmp}/pleb-hop-driver.XXXXXX")" || fail "cannot stage verified driver"
trap 'rm -rf -- "$snapshot"' EXIT
# Read Git blobs directly: index assume-unchanged/skip-worktree flags are not
# evidence about current bytes. Execute only the verified private snapshot.
python3 - "$driver_root" "$driver_ref" "$snapshot" <<'PYVERIFY' || fail "driver source verification failed"
import os
from pathlib import Path
import stat
import subprocess
import sys
root, ref, snapshot = Path(sys.argv[1]), sys.argv[2], Path(sys.argv[3])
git = ['git', '--no-replace-objects', '-C', str(root)]
for name in ('bin/pleb-release-hop', 'lib/update.sh', 'lib/closure.sh', 'lib/preserve.sh'):
    record = subprocess.check_output(git + ['ls-tree', '-z', ref, '--', name], timeout=10)
    fields = record.rstrip(b'\0').split(b'\t')
    if len(fields) != 2 or fields[1].decode() != name:
        raise SystemExit('driver module missing from requested tree: ' + name)
    mode, kind, oid = fields[0].decode().split()
    if mode not in ('100644', '100755') or kind != 'blob':
        raise SystemExit('driver module is not a regular Git blob: ' + name)
    size = int(subprocess.check_output(git + ['cat-file', '-s', oid], timeout=10))
    if size > 16 * 1024 * 1024:
        raise SystemExit('driver module exceeds size bound')
    expected = subprocess.check_output(git + ['cat-file', 'blob', oid], timeout=10)
    parent = root / Path(name).parent
    if not stat.S_ISDIR(parent.lstat().st_mode):
        raise SystemExit('driver module parent must be a real directory')
    fd = os.open(root / name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size != size:
            raise SystemExit('driver module is not the expected regular file: ' + name)
        if bool(info.st_mode & 0o111) != (mode == '100755'):
            raise SystemExit('driver module executable mode differs: ' + name)
        with os.fdopen(fd, 'rb', closefd=False) as stream:
            actual = stream.read(size + 1)
        if actual != expected:
            raise SystemExit('driver modules differ from the requested commit: ' + name)
    finally:
        os.close(fd)
    destination = snapshot / name
    destination.parent.mkdir(mode=0o700, exist_ok=True)
    with destination.open('xb') as stream:
        stream.write(expected)
    destination.chmod(0o755 if mode == '100755' else 0o644)
PYVERIFY
installed="$(readlink -f -- "$installed")"
PLEB_ROOT="$(cd "$(dirname "$installed")/.." && pwd -P)"
[ "$installed" = "$PLEB_ROOT/bin/pleb" ] && [ -f "$PLEB_ROOT/lib/common.sh" ] \
    && [ -d "$PLEB_ROOT/.git" ] || fail "installed CLI is not a Pleb source checkout"
[ "$driver_root" != "$PLEB_ROOT" ] || fail "bootstrap driver must be separate from the installed checkout"
# Preserve the installed resolver, operator configuration, and checkout identity.
# Only the release driver is taken from the explicit reviewed source commit.
(
    . "$PLEB_ROOT/lib/common.sh"
    . "$snapshot/lib/update.sh"
    do_update "$@"
)
